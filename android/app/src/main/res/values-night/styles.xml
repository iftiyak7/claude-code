<?xml version="1.0" encoding="utf-8"?>
<!-- Phone in dark mode: a dark base theme, so the app's "Auto" theme follows the phone. -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:colorAccent">@color/green</item>
    </style>
</resources>
