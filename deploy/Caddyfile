{
	email {$ACME_EMAIL}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
}

tadbeerdaily.com {
	redir https://www.tadbeerdaily.com{uri} permanent
}

www.tadbeerdaily.com {
	import security
	root * /srv/www
	encode zstd gzip
	try_files {path} {path}.html {path}/ /index.html
	file_server
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

api.tadbeerdaily.com {
	import security
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	reverse_proxy api:8080 {
		health_uri /health
	}
}

# Optional browser version of the app (expo export --platform web → deploy/app-web)
app.tadbeerdaily.com {
	import security
	root * /srv/app
	encode zstd gzip
	try_files {path} /index.html
	file_server
}
